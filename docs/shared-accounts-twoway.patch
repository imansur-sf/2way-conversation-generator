diff --git a/test/feedback.test.js b/test/feedback.test.js
index 2af7cfd..5e2a102 100644
--- a/test/feedback.test.js
+++ b/test/feedback.test.js
@@ -183,3 +183,18 @@ test('UPG admin identity is strict even when LPG administrator overrides are con
   await h.request('/feedback', { ...payload(), tool: 'upg', email: 'imansur@salesforce.com' });
   assert.equal((await h.request('/feedback/inbox?tool=upg', null, token('other@salesforce.com'))).status, 403);
