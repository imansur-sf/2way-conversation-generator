+
+
+test('Studio feedback is isolated and its inbox requires the verified imansur account', async t => {
+  const h = await serve(t, database(), { FEEDBACK_ADMIN_EMAILS: 'other@salesforce.com' });
+  const studio = await h.request('/feedback', {...payload(), tool:'twoway'}, undefined, 'studio_feedback_key_123');
+  assert.equal(studio.status, 201);
+  const id = (await studio.json()).id;
+  assert.equal((await (await h.request('/feedback/session?tool=twoway', null, token('other@salesforce.com'))).json()).admin, false);
+  assert.equal((await (await h.request('/feedback/session?tool=twoway', null, token('imansur@salesforce.com'))).json()).admin, true);
+  assert.equal((await h.request('/feedback/inbox?tool=twoway', null, token('other@salesforce.com'))).status, 403);
+  const inbox = await (await h.request('/feedback/inbox?tool=twoway', null, token('imansur@salesforce.com'))).json();
+  assert.equal(inbox.items.length, 1); assert.equal(inbox.items[0].tool, 'twoway');
+  assert.equal((await h.request('/feedback/inbox/' + id + '?tool=upg', null, token('imansur@salesforce.com'))).status, 404);
+  assert.equal((await h.request('/feedback/inbox/' + id + '?tool=lpg', null, token('other@salesforce.com'))).status, 404);
+});
